  "narrative": {
    "northStar": "La régie",
    "overview": "Tirage se lit comme une retransmission de poker. La main du joueur s'affiche comme à la télévision, cartes face visible, et les chiffres que la réalisation incruste à l'antenne (outs, probabilité exacte, règle du 2 et du 4, cotes, verdict) sont calculés en direct. Le fond est celui de la régie ; la couleur arrive par bandeaux entiers, comme les habillages d'antenne.\n\nLe système refuse la page SaaS sombre (titre, capture, rangée de cartes identiques) et le tapis de feutre vert. Un chiffre qui compte est toujours en jaune signal, et toujours calculé.",
    "keyCharacteristics": [
      "Bandeaux biseautés bleu télé qui couvrent des régions entières (incrustation, bande « exact contre tête »).",
      "Jaune signal réservé aux chiffres en direct et à l'action principale.",
      "Une seule famille, Saira, dont l'axe de largeur fait le travail : étroite et grasse pour l'antenne, normale pour la lecture.",
      "Cartes à jouer réelles, blanc cassé, enseignes rouge et noir, index français (V, D, R).",
      "Un fil défilant de faits chiffrés, comme en bas d'écran."
    ],
    "rules": [
      {
        "name": "The Live Figure Rule",
        "body": "Le jaune signal ne colore qu'un chiffre réellement calculé ou l'action principale ; jamais un mot de décor.",
        "section": "colors"
      },
      {
        "name": "The Band Rule",
        "body": "La couleur arrive par régions entières (bandeaux, bandes pleine largeur), jamais en touches éparpillées sur un fond neutre.",
        "section": "colors"
      },
      {
        "name": "The Width Axis Rule",
        "body": "La hiérarchie passe par la largeur et la graisse de Saira, pas par une deuxième famille.",
        "section": "typography"
      }
    ],
    "dos": [
      "Do afficher le calcul exact à côté de la règle du 2 et du 4, avec l'écart.",
      "Do calculer chaque chiffre affiché en jaune : aucun chiffre décoratif.",
      "Do utiliser de vraies cartes à jouer pour toute main."
    ],
    "donts": [
      "Don't poser un surtitre au-dessus d'un titre de section.",
      "Don't faire pulser le point « en direct » ni ajouter de halo lumineux.",
      "Don't utiliser un tapis de feutre vert ou des jetons en décor.",
      "Don't inventer avis, clients ou chiffres d'utilisateurs : la preuve, c'est la démo."
    ]
  }
}